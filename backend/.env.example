# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=drug_ocr_db

# ===== JWT 配置 =====
# 【必须修改】使用以下命令生成随机强密钥（长度不能少于 32 字符）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_YOUR_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Redis 配置（token 黑名单 + 登录限流）=====
# 启动前请确保 Redis 已运行: docker run -p 6379:6379 redis:7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== 首次启动自动创建管理员 =====
# 仅在 users 表为空时生效。首次部署后建议立即在管理后台修改密码。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@2026!
INITIAL_ADMIN_REAL_NAME=系统管理员

# ===== 登录限流配置 =====
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ===== 阿里云百炼 qwen-vl-ocr OCR 配置 =====
# 开通百炼后在控制台获取 API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_OCR_MODEL=qwen-vl-ocr-latest
QWEN_OCR_TIMEOUT_SECONDS=120
QWEN_OCR_MAX_ATTEMPTS=2
QWEN_OCR_MAX_PIXELS=2097152
QWEN_OCR_PER_RECORD_CONCURRENCY=2
QWEN_OCR_GLOBAL_CONCURRENCY=3
MAX_OCR_IMAGES_PER_RECORD=6

# ===== 阿里云 OSS（Qwen OCR 图片临时签名 URL）=====
# Qwen OCR 图片统一先上传 OSS，再把临时签名 URL 传给百炼；Endpoint 必须能被百炼公网访问
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_OCR_PREFIX=ocr/qwen
ALIYUN_OSS_SIGNED_URL_EXPIRE_SECONDS=1800

# ===== DeepSeek 多图一致性辅助校验 =====
# 仅在多图 OCR 缺少可交叉验证字段时触发，结论只用于人工审核提示
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30

# ===== 文件上传配置 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ===== 预警配置 =====
EXPIRY_WARNING_DAYS=30
LOW_STOCK_THRESHOLD=10

# ===== 阿里云 SMTP 邮件配置（用于忘记密码，P2 功能）=====
# 开通阿里云邮件推送服务后，在控制台获取 SMTP 账号和授权码
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=药品管理系统 <noreply@yourdomain.com>
SMTP_USE_SSL=true

# ===== 前端域名（邮件中的重置密码链接）=====
FRONTEND_URL=https://your-domain.com

# ===== 服务配置 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
